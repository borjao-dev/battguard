// Optional: let administrators on a local, active session change the battery
// charge limit without typing a password. Installed only with
// "install.sh --passwordless".
polkit.addRule(function(action, subject) {
    if (action.id === "io.github.battguard.set-limit" &&
        subject.local && subject.active &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo"))) {
        return polkit.Result.YES;
    }
});
